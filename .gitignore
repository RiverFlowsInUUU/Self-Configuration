# ── 本地 / 私有配置 ─────────────────────────────────────────────────────
# 使用者把自己的真实节点填进副本后，不要让 git 看见
my.conf
*.local.conf
*.private.conf
profiles/local/
**/profiles/local/

# ── 私钥 / 凭据兜底 ─────────────────────────────────────────────────────
# Egern 的 MITM CA 是 .p12 私钥容器；节点配置里导出的密钥同理。
# 注意只挡私钥容器，**不放 *.crt** —— 导出的公钥证书有时是要留档的。
*.p12
*.pfx
*.key
*.pem
*.pkcs12
.env
.env.*

# ── 审计脚本的运行产物 ───────────────────────────────────────────────────
# 规则集缓存（默认写在系统临时目录，这里兜底）
surge-ruleset-cache/
*.mmdb

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 编辑器 / 系统 ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ── 抓包产物（定位泄露时可能生成）────────────────────────────────────────
*.pcap
*.pcapng

*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.orig
desktop.ini
*.log
*.tmp
*.bak
